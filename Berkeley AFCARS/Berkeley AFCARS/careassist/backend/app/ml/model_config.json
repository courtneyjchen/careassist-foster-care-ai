{
  "model_metadata": {
    "algorithm": "XGBoost (GBT Classifier)",
    "n_estimators": 500,
    "max_depth": 8,
    "learning_rate": 0.05,
    "training_data": "AFCARS FY2020-2024, 5.76M records",
    "roc_auc": 0.9057,
    "recall": 0.91,
    "precision": 0.58,
    "threshold": 0.40,
    "n_features": 33,
    "target": "placement_disruption (NUMPLEP change > 0 within 12 months)",
    "positive_rate": 0.36,
    "trained_date": "2025-12-01"
  },
  "feature_definitions": [
    {"name": "los_latest_removal",      "type": "numeric", "importance": 0.155, "description": "Length of stay in latest removal (months)"},
    {"name": "los_current_setting",     "type": "numeric", "importance": 0.141, "description": "Length of stay in current placement setting (months)"},
    {"name": "placement_type_group",    "type": "binary",  "importance": 0.128, "description": "Placement type: Group Home"},
    {"name": "placement_type_resid",    "type": "binary",  "importance": 0.115, "description": "Placement type: Residential / Institution"},
    {"name": "placement_type_foster",   "type": "binary",  "importance": 0.042, "description": "Placement type: Foster Home"},
    {"name": "placement_type_kinship",  "type": "binary",  "importance": 0.038, "description": "Placement type: Kinship Care"},
    {"name": "placement_type_preadopt", "type": "binary",  "importance": 0.020, "description": "Placement type: Pre-Adoptive Home"},
    {"name": "total_removals",          "type": "numeric", "importance": 0.045, "description": "Total prior placement episodes"},
    {"name": "age_at_removal",          "type": "numeric", "importance": 0.039, "description": "Child's age at time of removal"},
    {"name": "has_behavioral",          "type": "binary",  "importance": 0.032, "description": "Child has behavioral health needs"},
    {"name": "has_disability",          "type": "binary",  "importance": 0.028, "description": "Child has a diagnosed disability"},
    {"name": "has_clinical_disability", "type": "binary",  "importance": 0.018, "description": "Child has clinical/medical needs"},
    {"name": "NEGLECT",                 "type": "binary",  "importance": 0.025, "description": "Removal reason: Neglect"},
    {"name": "PHYABUSE",                "type": "binary",  "importance": 0.024, "description": "Removal reason: Physical abuse"},
    {"name": "SEXABUSE",                "type": "binary",  "importance": 0.009, "description": "Removal reason: Sexual abuse"},
    {"name": "ABANDMNT",                "type": "binary",  "importance": 0.019, "description": "Removal reason: Abandonment"},
    {"name": "NOCOPE",                  "type": "binary",  "importance": 0.016, "description": "Removal reason: Caregiver inability to cope"},
    {"name": "HOUSING",                 "type": "binary",  "importance": 0.013, "description": "Removal reason: Inadequate housing"},
    {"name": "DAPARENT",                "type": "binary",  "importance": 0.012, "description": "Removal reason: Drug abuse by parent"},
    {"name": "AAPARENT",                "type": "binary",  "importance": 0.011, "description": "Removal reason: Alcohol abuse by parent"},
    {"name": "num_removal_reasons",     "type": "numeric", "importance": 0.022, "description": "Count of removal reason flags"},
    {"name": "permanency_goal_adopt",   "type": "binary",  "importance": 0.010, "description": "Permanency goal: Adoption"},
    {"name": "permanency_goal_reunif",  "type": "binary",  "importance": 0.008, "description": "Permanency goal: Reunification"},
    {"name": "permanency_goal_emanc",   "type": "binary",  "importance": 0.009, "description": "Permanency goal: Emancipation"},
    {"name": "permanency_goal_guard",   "type": "binary",  "importance": 0.006, "description": "Permanency goal: Guardianship"},
    {"name": "mandatory_removal",       "type": "binary",  "importance": 0.015, "description": "Court-ordered / mandatory removal"},
    {"name": "ever_adopted",            "type": "binary",  "importance": 0.014, "description": "Child was previously adopted"},
    {"name": "tpr_status",              "type": "binary",  "importance": 0.007, "description": "Parental rights terminated"}
  ],
  "scoring_rules": {
