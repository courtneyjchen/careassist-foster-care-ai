# ──────────────────────────────────────────────
# CareAssist – Local Development
# ──────────────────────────────────────────────

# ── Database (SQLite for local dev, no install needed) ──
# Uncomment below for PostgreSQL (Docker / production):
# DATABASE_URL=postgresql+asyncpg://careassist:careassist_dev_2025@localhost:5432/careassist

# ── AWS S3 (leave blank to disable file uploads) ─
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=careassist-files

# ── Ollama (AI Chatbot) ─────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Backend ──────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=local-dev-secret-key-change-in-prod
CORS_ORIGINS=http://localhost:4200,http://localhost:80

# ── Frontend ─────────────────────────────────
FRONTEND_PORT=4200
API_URL=http://localhost:8000
